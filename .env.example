# Database Configuration
DB_USER=your_username_here
DB_PASSWORD=your_strong_password_here
DB_NAME=ufc_matchmaker_db

# Application Configuration
PORT=8090

# Full database URL
DATABASE_URL=postgres://USER:PASSWORD@db:5432/DBNAME?sslmode=disable

# How often (in hours) the server re-scrapes ufc.com/rankings to keep the
# /rankings page in sync
RANKINGS_SCRAPE_INTERVAL_HOURS=6